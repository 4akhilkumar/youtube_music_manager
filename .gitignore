Songs/
venv/

# downloads.db is tracked deliberately, at the owner's request.
#
# It is ~87 MB, of which ~85 MB is cover-art blobs that refetch from image_url.
# Git stores binaries whole, so every commit that touches it adds another full
# copy. Commit it sparingly, not on every run. GitHub rejects files over 100 MB.

# Sidecars are transient and must never be committed: a WAL committed alongside
# a checkpointed database would be inconsistent with it.
downloads.db-wal
downloads.db-shm
downloads.db.bak
downloads.db.prechange
# WAL sidecars SQLite leaves beside any snapshot it opens
downloads.db.bak-wal
downloads.db.bak-shm
downloads.db.prechange-wal
downloads.db.prechange-shm
*.old

# macOS / Python noise
.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
