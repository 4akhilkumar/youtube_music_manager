Songs/
venv/

# Generated by classify.py, rebuildable from the database in seconds.
Playlists/
# Transient: regenerated by --review for whatever is not yet labelled.
remaining.json

# Tracked deliberately, all of it work that is expensive or impossible to redo:
#   review.json   the curated labels for all 508 tracks - cannot be regenerated
#   features.npz  the MERT/CLAP embeddings, ~30-60 min of inference (--restore-features)
#   probe.pkl     the trained probe
#   downloads.db  full state, tracked at the owner's request
#
# On downloads.db specifically: it is ~89 MB, of which ~83 MB is cover-art blobs
# that refetch from image_url. Git stores binaries whole, so every commit that
# touches it adds another full copy - which is what left .git at ~137 MB before
# c52589a stopped tracking it. Commit it sparingly, not on every run. If the
# repository needs slimming later, features.npz + review.json are enough to
# rebuild everything except activity_log.

# Sidecars are transient and must never be committed: a WAL committed alongside
# a checkpointed database would be inconsistent with it.
downloads.db-wal
downloads.db-shm
downloads.db.bak
downloads.db.prechange
# WAL sidecars SQLite leaves beside any snapshot it opens
downloads.db.bak-wal
downloads.db.bak-shm
downloads.db.prechange-wal
downloads.db.prechange-shm
*.old

