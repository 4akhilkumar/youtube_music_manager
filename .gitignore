# Generated by classify.py, all rebuildable from the database in seconds.
Playlists/
probe.pkl
# Transient: regenerated by --review for whatever is not yet labelled.
remaining.json

# NOT ignored, deliberately: review.json holds the hand-and-LLM-curated labels
# for all 508 tracks. It is an input, not an output - the probe is trained from
# it, and downloads.db (which mirrors it into track_labels) is itself ignored,
# so this file is the only durable copy of work that cannot be regenerated.

# Local state, not source. The cover-art blobs make this ~80MB, and every
# commit that touched it added another full copy to the repository.
downloads.db
downloads.db-wal
downloads.db-shm
downloads.db.bak
downloads.db.prechange
# WAL sidecars SQLite leaves beside any snapshot it opens
downloads.db.bak-wal
downloads.db.bak-shm
downloads.db.prechange-wal
downloads.db.prechange-shm
